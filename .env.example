# PostgreSQL connection string
DATABASE_URL=postgres://postgres:postgres@localhost:5432/traindb?sslmode=disable

# Redis address (host:port)
REDIS_URL=localhost:6379

# Kafka broker address (host:port). Use localhost:29092 with docker-compose.
KAFKA_ADDR=localhost:29092

# Kafka topic for user-created events (optional, default: user-created)
KAFKA_TOPIC=user-created

# HTTP listen address (optional, default: :8080)
HTTP_ADDR=:8080

# How often the outbox relay polls for pending events (optional, default: 1s)
OUTBOX_POLL_INTERVAL=1s
# Max events published per outbox batch (optional, default: 100)
OUTBOX_BATCH_SIZE=100

# Per-IP rate limit on /users endpoints (optional, defaults: 20 rps, burst 40)
RATE_LIMIT_RPS=20
RATE_LIMIT_BURST=40

# Require a bearer JWT on POST/PUT/DELETE /users (optional, default: true)
AUTH_ENABLED=true
# Client credentials accepted by POST /auth/token (required when auth is enabled)
AUTH_CLIENT_ID=user-api-client
AUTH_CLIENT_SECRET=change-me
# HS256 signing secret for issued tokens (required when auth is enabled)
JWT_SECRET=change-me-too
# Lifetime of issued tokens (optional, default: 15m)
JWT_TTL=15m

# Enable pprof debug server on PPROF_ADDR (optional, default: false)
PPROF_ENABLED=false
PPROF_ADDR=localhost:6060
