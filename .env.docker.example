# Docker-compose environment. Copy to .env.docker before `docker compose up`:
#   cp .env.docker.example .env.docker
# Hosts are compose service names, not localhost.

DATABASE_URL=postgres://postgres:postgres@postgres:5432/traindb?sslmode=disable
REDIS_URL=redis:6379
KAFKA_ADDR=kafka:9092
KAFKA_TOPIC=user-created
HTTP_ADDR=:8080

# Dev-only credentials and signing secret; change them outside local compose.
AUTH_ENABLED=true
AUTH_CLIENT_ID=user-api-client
AUTH_CLIENT_SECRET=change-me
JWT_SECRET=change-me-too
JWT_TTL=15m
